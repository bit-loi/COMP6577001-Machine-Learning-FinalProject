# Bookstore .gitignore

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# System Files
Thumbs.db
desktop.ini

# Configuration Files (sensitive)
.env

# Logs
*.log
logs/

# Temporary Files
tmp/
temp/
cache/

# Uploaded Images (if large)
# images/uploads/

# Vendor (if using Composer)
vendor/

# Node Modules (if using npm)
node_modules/

# ML service local artifacts
ml_services/hf-space/
ml_services/venv/
ml_services/__pycache__/
ml_services/.env

# Database Backups
*.sql
database/backups/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


#Ignore vscode AI rules
.github\instructions\codacy.instructions.md
